<Window x:Class="MyVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:MyVault.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyVault.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{loc:Loc Key=k77406d4cbd55}"
        Height="760" Width="1080"
        MinHeight="540" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource App.Background}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar — controlled manually by the transition logic -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0"
              Height="40"
              Margin="16,0,0,0"
              Visibility="Collapsed"
              Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/Application.png"
                       Width="20" Height="20"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{loc:Loc Key=k77406d4cbd55}" FontSize="{DynamicResource App.Font.Body}" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Text}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinBtn" Click="MinBtn_Click"
                        Width="46" Height="40" Padding="0"
                        Style="{StaticResource GhostButton}" BorderThickness="0"
                        HorizontalContentAlignment="Center" Focusable="False">
                    <TextBlock Text="&#xE921;" FontFamily="{StaticResource App.IconFont}" FontSize="10"
                               Foreground="{DynamicResource App.Text}"/>
                </Button>
                <Button x:Name="MaxBtn" Click="MaxBtn_Click"
                        Width="46" Height="40" Padding="0"
                        Style="{StaticResource GhostButton}" BorderThickness="0"
                        HorizontalContentAlignment="Center" Focusable="False">
                    <TextBlock x:Name="MaxIcon" Text="&#xE922;"
                               FontFamily="{StaticResource App.IconFont}" FontSize="10"
                               Foreground="{DynamicResource App.Text}"/>
                </Button>
                <Button x:Name="CloseBtn" Click="CloseBtn_Click"
                        Width="46" Height="40" Padding="0"
                        Style="{StaticResource GhostButton}" BorderThickness="0"
                        HorizontalContentAlignment="Center" Focusable="False"
                        Background="Transparent">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource App.IconFont}" FontSize="10"
                               Foreground="{DynamicResource App.Text}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content host — animated swap between UnlockView and VaultView -->
        <ContentControl x:Name="ContentHost" Grid.Row="1"
                        Opacity="1"
                        RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <TranslateTransform x:Name="ContentTransform" Y="0"/>
            </ContentControl.RenderTransform>
        </ContentControl>
    </Grid>
</Window>