<Application x:Class="MyVault.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:MyVault.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MyVault.App.ViewModels"
             xmlns:views="clr-namespace:MyVault.App.Views"
             xmlns:conv="clr-namespace:MyVault.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/MoonlightGlow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <loc:ChoiceLabelConverter x:Key="ChoiceLabel"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>

            <DataTemplate DataType="{x:Type vm:UnlockViewModel}">
                <views:UnlockView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VaultViewModel}">
                <views:VaultView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>