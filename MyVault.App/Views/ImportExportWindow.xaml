<views:GlassWindow x:Class="MyVault.App.Views.ImportExportWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:vm="clr-namespace:MyVault.App.ViewModels"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   d:DataContext="{d:DesignInstance Type=vm:ImportExportViewModel}"
                   Title="Backup &amp; Import / Export"
                   Width="500"
                   SizeToContent="Height">

    <Border Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.BorderGlass}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Backup &amp; Import / Export"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Encrypted backup"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"/>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,4,0,10">
                    Saves a byte-for-byte copy of your vault file. Fully encrypted, safe to
                    keep in cloud storage or on a USB stick.
                </TextBlock>
                <Button Content="Save encrypted backup…"
                        Command="{Binding SaveBackupCommand}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Restore encrypted backup…" Command="{Binding RestoreBackupCommand}" Margin="0,8,0,0"/>

            </StackPanel>

            <Separator Grid.Row="1" Margin="0,16" Background="{DynamicResource App.BorderSubtle}"/>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Export to CSV (plaintext)"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"/>
                <Border Background="{DynamicResource App.WarningBg}"
                        CornerRadius="6" Padding="10,8" Margin="0,4,0,10">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource App.Warning}">
                        CSV is NOT encrypted. Anyone with the file can read every password.
                        Delete it immediately after use.
                    </TextBlock>
                </Border>
                <Button Content="Export to CSV…"
                        Command="{Binding ExportCsvCommand}"
                        HorizontalAlignment="Left"/>
            </StackPanel>

            <Separator Grid.Row="3" Margin="0,16" Background="{DynamicResource App.BorderSubtle}"/>

            <StackPanel Grid.Row="4">
                <TextBlock Text="Import from CSV"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"/>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,4,0,10">
                    Supported columns: Title (required), Username, Password, URL, Notes, Tags.
                    Imported entries are appended to your vault.
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Import from CSV…"
                            Command="{Binding ImportCsvCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Download CSV template"
                            Command="{Binding DownloadTemplateCommand}"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Row="5"
                    Content="Close"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    IsCancel="True"
                    Click="Close_Click"/>
        </Grid>
    </Border>
</views:GlassWindow>