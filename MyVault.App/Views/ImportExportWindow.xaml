<views:GlassWindow x:Class="MyVault.App.Views.ImportExportWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:loc="clr-namespace:MyVault.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:vm="clr-namespace:MyVault.App.ViewModels"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   d:DataContext="{d:DesignInstance Type=vm:ImportExportViewModel}"
                   Title="{loc:Loc Key=k1a9666ced629}"
                   Width="500"
                   SizeToContent="Height">

    <Border Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.BorderGlass}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="{DynamicResource App.DialogMaxHeight}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{loc:Loc Key=k1a9666ced629}"
                           FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="{loc:Loc Key=k0e6b09c31f1e}"
                           FontSize="{DynamicResource App.Font.Body}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"/>
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource App.Font.Small}"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,4,0,10" Text="{loc:Loc Key=kac788a2a8c44}"/>
                <Button Content="{loc:Loc Key=k20377c05d54e}"
                        Command="{Binding SaveBackupCommand}"
                        HorizontalAlignment="Left" Padding="12,6" MinHeight="32"
                        Style="{StaticResource PrimaryButton}"/>
                    <Button Content="{loc:Loc Key=k0b35d016eeb4}" Command="{Binding RestoreBackupCommand}" HorizontalAlignment="Left" Padding="12,6" MinHeight="32" Margin="0,8,0,0"/>

            </StackPanel>

            <Separator Grid.Row="1" Margin="0,16" Background="{DynamicResource App.BorderSubtle}"/>

            <StackPanel Grid.Row="2">
                <TextBlock Text="{loc:Loc Key=k3d0323708ced}"
                           FontSize="{DynamicResource App.Font.Body}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"/>
                <Border Background="{DynamicResource App.WarningBg}"
                        CornerRadius="6" Padding="10,8" Margin="0,4,0,10">
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource App.Font.Small}"
                               Foreground="{DynamicResource App.Warning}" Text="{loc:Loc Key=ke01c69c5b15b}"/>
                </Border>
                <Button Content="{loc:Loc Key=k8d22a71282b2}"
                        Command="{Binding ExportCsvCommand}"
                        HorizontalAlignment="Left" Padding="12,6" MinHeight="32"/>
            </StackPanel>

            <Separator Grid.Row="3" Margin="0,16" Background="{DynamicResource App.BorderSubtle}"/>

            <StackPanel Grid.Row="4">
                <TextBlock Text="{loc:Loc Key=k9b1685f5ca12}"
                           FontSize="{DynamicResource App.Font.Body}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"/>
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource App.Font.Small}"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,4,0,10" Text="{loc:Loc Key=k0916eb6dd7d9}"/>
                <TextBlock Text="{loc:Loc Key=kc8de48edd183}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding ImportSources}" SelectedItem="{Binding ImportSource}"
                          HorizontalAlignment="Left" MinWidth="180" Margin="0,0,0,10">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource ChoiceLabel}"><Binding/><Binding Source="{x:Static loc:LocalizationService.Instance}" Path="Language"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel Margin="-4,0,-4,0">
                    <Button Content="{loc:Loc Key=k79514b769fcd}" Command="{Binding ImportCsvCommand}"
                            Padding="12,6" MinHeight="32" VerticalAlignment="Center" Margin="4,0,4,8"/>
                    <Button Content="{loc:Loc Key=k67f46a1d5a5d}" Command="{Binding DownloadTemplateCommand}"
                            Padding="12,6" MinHeight="32" VerticalAlignment="Center" Margin="4,0,4,8"/>
                </WrapPanel>
            </StackPanel>

            </Grid>
            </ScrollViewer>
            <Button Grid.Row="1"
                    Content="{loc:Loc Key=k7d9eb7acb13e}"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    IsCancel="True"
                    Click="Close_Click"/>
        </Grid>
    </Border>
</views:GlassWindow>