<views:GlassWindow x:Class="MyVault.App.Views.HelpWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   Title="Help &amp; Guide"
                   Width="580" Height="640">

    <Border Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.BorderGlass}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Help &amp; Guide" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"/>
                <TextBlock Text="Everything you need to use MyVault." FontSize="12"
                           Foreground="{DynamicResource App.TextMuted}" Margin="0,4,0,16"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text=" Keyboard shortcuts" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" Margin="0,0,0,10"/>

                    <Border Background="{DynamicResource App.SurfaceGlass}" CornerRadius="8"
                            BorderBrush="{DynamicResource App.BorderGlass}" BorderThickness="1"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + N" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Create a new entry"
                                       Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + F" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Focus the search box"
                                       Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + L" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Lock the vault immediately"
                                       Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Enter" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Edit the selected entry"
                                       Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Delete" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Delete the selected entry"
                                       Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Esc" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Clear search / close dialog"
                                       Foreground="{DynamicResource App.Text}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="How it works" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" Margin="0,20,0,10"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource App.TextMuted}" LineHeight="18">
                        Your vault is encrypted with AES-256-GCM using a key derived from your
                        master password via Argon2id. The master password is never stored —
                        if you lose it, the vault cannot be opened by anyone, including you.
                        <LineBreak/><LineBreak/>
                        Every time you save, a new random nonce is used and a rotated backup
                        is created (vault.dat.bak.1 through .bak.5). The clipboard is cleared
                        automatically after the number of seconds you choose in Settings, and
                        the vault auto-locks on idle or when Windows locks (Win+L).
                    </TextBlock>

                    <TextBlock Text="Features" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" Margin="0,20,0,10"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource App.Text}" LineHeight="20">
                        • Add, edit, and delete password entries
                        <LineBreak/>• Live search across title, username, URL, notes, tags
                        <LineBreak/>• Vault Categories filter
                        <LineBreak/>• Built-in password generator (20 chars, strong)
                        <LineBreak/>• Password health panel (weak / reused / old)
                        <LineBreak/>• Encrypted backup export
                        <LineBreak/>• CSV import / export
                        <LineBreak/>• Auto-lock, Safe clipboard auto-clear, Win+L lock
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right"
                    Margin="0,16,0,0" IsCancel="True" IsDefault="True" Click="Close_Click"/>
        </Grid>
    </Border>
</views:GlassWindow>