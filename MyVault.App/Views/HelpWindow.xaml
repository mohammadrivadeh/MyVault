<views:GlassWindow x:Class="MyVault.App.Views.HelpWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:loc="clr-namespace:MyVault.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   Title="{loc:Loc Key=k2afe6dca34b9}"
                   Width="580" Height="640">

    <Border Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.BorderGlass}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{loc:Loc Key=k2afe6dca34b9}" FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"/>
                <TextBlock Text="{loc:Loc Key=k7c22b704c83a}" FontSize="{DynamicResource App.Font.Small}"
                           Foreground="{DynamicResource App.TextMuted}" Margin="0,4,0,16"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="{loc:Loc Key=ke9bef0b0f3c2}" FontSize="{DynamicResource App.Font.Body}" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" Margin="0,0,0,10"/>

                    <Border Background="{DynamicResource App.SurfaceGlass}" CornerRadius="8"
                            BorderBrush="{DynamicResource App.BorderGlass}" BorderThickness="1"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=kb0e94028b8ba}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc Key=kb3b428605fcf}"
                                       Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=k7a3717c57d33}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Loc Key=k7bef9b9b8e8b}"
                                       Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=kccd3f60f5fce}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Loc Key=k773f58b4480b}"
                                       Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Key=kdc8659db6d41}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Loc Key=k2e6b7214044c}"
                                       Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Key=ke2d0a54968ea}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:Loc Key=k006698983c7c}"
                                       Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Key=k52f878edb34f}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Accent}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{loc:Loc Key=ka5e6d55fdfd6}"
                                       Foreground="{DynamicResource App.Text}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{loc:Loc Key=k9c870aa6e5e9}" FontSize="{DynamicResource App.Font.Body}" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" Margin="0,20,0,10"/>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource App.Font.Small}"
                               Foreground="{DynamicResource App.TextMuted}" LineHeight="18"><Run Text="{loc:Loc Key=k5f1012f91aa4}"/><LineBreak/><LineBreak/><Run Text="{loc:Loc Key=k42cc81064b2f}"/></TextBlock>

                    <TextBlock Text="{loc:Loc Key=k5697d03daef4}" FontSize="{DynamicResource App.Font.Body}" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" Margin="0,20,0,10"/>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource App.Font.Small}"
                               Foreground="{DynamicResource App.Text}" LineHeight="20"><Run Text="{loc:Loc Key=ke6c9a249a1cc}"/><LineBreak/><Run Text="{loc:Loc Key=k9577cd7f076e}"/><LineBreak/><Run Text="{loc:Loc Key=ke354ddd9e77e}"/><LineBreak/><Run Text="{loc:Loc Key=k4b92f5800a39}"/><LineBreak/><Run Text="{loc:Loc Key=k0d9eba99cf24}"/><LineBreak/><Run Text="{loc:Loc Key=k45776fef1934}"/><LineBreak/><Run Text="{loc:Loc Key=k4550ffb079ca}"/><LineBreak/><Run Text="{loc:Loc Key=k3d293aa7c9ba}"/></TextBlock>

                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="{loc:Loc Key=k7d9eb7acb13e}" HorizontalAlignment="Right"
                    Margin="0,16,0,0" IsCancel="True" IsDefault="True" Click="Close_Click"/>
        </Grid>
    </Border>
</views:GlassWindow>