<views:GlassWindow x:Class="MyVault.App.Views.HealthWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:loc="clr-namespace:MyVault.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:vm="clr-namespace:MyVault.App.ViewModels"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   d:DataContext="{d:DesignInstance Type=vm:HealthViewModel}"
                   Title="{loc:Loc Key=kd6adabed5fee}"
                   Width="560" Height="520">

    <Border Background="{DynamicResource App.SurfaceGlass}"
            BorderBrush="{DynamicResource App.BorderGlass}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="🔎" FontSize="{DynamicResource App.Font.Hero}"
                           Foreground="{DynamicResource App.Accent}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc Key=kd6adabed5fee}"
                           FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,4"/>
                <TextBlock Text="{Binding SummaryText}"
                           Foreground="{DynamicResource App.TextMuted}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Report.Findings}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,3"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,11"
                                Background="{DynamicResource App.SurfaceGlass}"
                                BorderBrush="{DynamicResource App.BorderGlass}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Entry.Title}"
                                               FontSize="{DynamicResource App.Font.Body}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.Text}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Entry.Username}"
                                               FontSize="{DynamicResource App.Font.Small}"
                                               Foreground="{DynamicResource App.TextMuted}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource App.WarningBg}"
                                        Padding="8,2" CornerRadius="4"
                                        Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="{DynamicResource App.Font.Small}" Foreground="{DynamicResource App.Warning}">
                                        <TextBlock.Text><MultiBinding Converter="{StaticResource ChoiceLabel}"><Binding Path="IssuesText"/><Binding Source="{x:Static loc:LocalizationService.Instance}" Path="Language"/></MultiBinding></TextBlock.Text>
                                    </TextBlock>
                                </Border>

                                <Button Grid.Column="2" Content="{loc:Loc Key=k21f1595b614f}"
                                        Padding="12,4"
                                        VerticalAlignment="Center"
                                        Click="Fix_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{loc:Loc Key=k7d9eb7acb13e}" IsCancel="True" IsDefault="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</views:GlassWindow>