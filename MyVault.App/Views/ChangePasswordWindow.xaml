<views:GlassWindow x:Class="MyVault.App.Views.ChangePasswordWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:vm="clr-namespace:MyVault.App.ViewModels"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   d:DataContext="{d:DesignInstance Type=vm:ChangePasswordViewModel}"
                   Title="Change Master Password"
                   Width="460"
                   SizeToContent="Height">

    <Border Background="{DynamicResource App.Background}"
        BorderBrush="{DynamicResource App.BorderGlass}"
        BorderThickness="1"
        CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Change Master Password"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Current master password"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,0,0,4"/>
                <PasswordBox x:Name="CurrentBox" PasswordChanged="CurrentBox_PasswordChanged"/>

                <TextBlock Text="New master password (12+ characters)"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,14,0,4"/>
                <PasswordBox x:Name="NewBox" PasswordChanged="NewBox_PasswordChanged"/>

                <TextBlock Text="Confirm new password"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,14,0,4"/>
                <PasswordBox x:Name="ConfirmBox" PasswordChanged="ConfirmBox_PasswordChanged"/>

                <TextBlock Text="{Binding ErrorText}"
                           Foreground="{DynamicResource App.Error}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullOrEmptyToVis}}"/>

                <Border Background="{DynamicResource App.WarningBg}"
                        CornerRadius="8" Padding="10,8" Margin="0,14,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource App.Warning}">
                        Existing backups (*.bak.N) were encrypted with the old password
                        and will not open with the new one. Delete them if that matters.
                    </TextBlock>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="ChangeButton" Content="Change Password"
                        IsDefault="True" Click="Change_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</views:GlassWindow>