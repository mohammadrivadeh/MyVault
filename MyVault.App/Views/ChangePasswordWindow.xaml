<views:GlassWindow x:Class="MyVault.App.Views.ChangePasswordWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:loc="clr-namespace:MyVault.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:vm="clr-namespace:MyVault.App.ViewModels"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   d:DataContext="{d:DesignInstance Type=vm:ChangePasswordViewModel}"
                   Title="{loc:Loc Key=kaa7f9577bfca}"
                   Width="460"
                   SizeToContent="Height">

    <Border Background="{DynamicResource App.Background}"
        BorderBrush="{DynamicResource App.BorderGlass}"
        BorderThickness="1"
        CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{loc:Loc Key=kaa7f9577bfca}"
                           FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"
                           Margin="0,0,0,20"/>

                <TextBlock Text="{loc:Loc Key=k6e655daac98b}"
                           FontSize="{DynamicResource App.Font.Small}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,0,0,4"/>
                <PasswordBox FlowDirection="LeftToRight" Language="en-US" x:Name="CurrentBox" PasswordChanged="CurrentBox_PasswordChanged"/>

                <TextBlock Text="{loc:Loc Key=k96649ed55ebc}"
                           FontSize="{DynamicResource App.Font.Small}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,14,0,4"/>
                <PasswordBox FlowDirection="LeftToRight" Language="en-US" x:Name="NewBox" PasswordChanged="NewBox_PasswordChanged"/>

                <TextBlock Text="{loc:Loc Key=kbf000421aeb3}"
                           FontSize="{DynamicResource App.Font.Small}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,14,0,4"/>
                <PasswordBox FlowDirection="LeftToRight" Language="en-US" x:Name="ConfirmBox" PasswordChanged="ConfirmBox_PasswordChanged"/>

                <TextBlock Text="{Binding ErrorText}"
                           Foreground="{DynamicResource App.Error}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullOrEmptyToVis}}"/>

                <Border Background="{DynamicResource App.WarningBg}"
                        CornerRadius="8" Padding="10,8" Margin="0,14,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource App.Font.Small}"
                               Foreground="{DynamicResource App.Warning}" Text="{loc:Loc Key=k601f6d9de537}"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{loc:Loc Key=k19766ed6ccb2}" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="ChangeButton" Content="{loc:Loc Key=ka949f4623074}"
                        IsDefault="True" Click="Change_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</views:GlassWindow>