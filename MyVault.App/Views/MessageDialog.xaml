<views:GlassWindow x:Class="MyVault.App.Views.MessageDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:loc="clr-namespace:MyVault.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   Title="{loc:Loc Key=k77406d4cbd55}"
                   Width="440"
                   SizeToContent="Height"
                   WindowStartupLocation="CenterOwner"
                   ShowInTaskbar="False">

    <Border Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.BorderGlass}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Icon + Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border x:Name="IconBubble"
                        Width="44" Height="44"
                        CornerRadius="22"
                        VerticalAlignment="Top"
                        Margin="0,0,14,0">
                    <TextBlock x:Name="IconGlyph"
                               FontFamily="{StaticResource App.IconFont}"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TitleText"
                           FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"
                           VerticalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Message -->
            <TextBlock Grid.Row="1"
                       x:Name="MessageText"
                       FontSize="{DynamicResource App.Font.Body}"
                       Foreground="{DynamicResource App.Text}"
                       TextWrapping="Wrap"
                       LineHeight="20"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button x:Name="CancelButton"
                        Content="{loc:Loc Key=k19766ed6ccb2}"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"/>

                <Button x:Name="NoButton"
                        Content="{loc:Loc Key=k1ea442a134b2}"
                        Click="No_Click"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"/>

                <Button x:Name="OkButton"
                        Content="{loc:Loc Key=k565339bc4d33}"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="Ok_Click"
                        Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</views:GlassWindow>