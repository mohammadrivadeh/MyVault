<views:GlassWindow x:Class="MyVault.App.Views.AboutWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   Title="About MyVault"
                   Width="480" SizeToContent="Height">

    <Border Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.BorderGlass}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border Width="88" Height="88" CornerRadius="20"
        Background="{DynamicResource App.AccentSubtle}"
        HorizontalAlignment="Center">
                    <Image Source="/Assets/Application.png"
           Width="60" Height="60"
           Stretch="Uniform"
           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="MyVault" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource App.Text}"
                           HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <TextBlock x:Name="VersionText" Text="Version 1.0.0" FontSize="12"
                           Foreground="{DynamicResource App.TextMuted}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Border Background="{DynamicResource App.SurfaceGlass}" CornerRadius="8"
                        BorderBrush="{DynamicResource App.BorderGlass}" BorderThickness="1"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="A personal, offline password manager."
                                   FontSize="13" Foreground="{DynamicResource App.Text}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMuted}"
                                   TextWrapping="Wrap" LineHeight="18">
                            All data is stored in a single encrypted file on this computer.
                            No cloud. No accounts. No telemetry. Your master password never
                            leaves this machine.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource App.SurfaceGlass}" CornerRadius="8"
                        BorderBrush="{DynamicResource App.BorderGlass}" BorderThickness="1"
                        Padding="14" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Encryption" FontSize="12"
                                   Foreground="{DynamicResource App.TextMuted}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="AES-256-GCM + Argon2id" FontSize="12"
                                   Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Data location" FontSize="12"
                                   Foreground="{DynamicResource App.TextMuted}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="MyVault\vault.dat" FontSize="12"
                                   Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="License" FontSize="12"
                                   Foreground="{DynamicResource App.TextMuted}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Personal use" FontSize="12"
                                   Foreground="{DynamicResource App.Text}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock Text="© 2026 — Built for personal, offline security."
                           FontSize="11" Foreground="{DynamicResource App.TextMuted}"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <Button Content="Close" HorizontalAlignment="Center"
                        MinWidth="100" IsCancel="True" IsDefault="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</views:GlassWindow>