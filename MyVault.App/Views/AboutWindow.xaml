<views:GlassWindow x:Class="MyVault.App.Views.AboutWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:loc="clr-namespace:MyVault.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   Title="{loc:Loc Key=k7517008928da}"
                   Width="480" SizeToContent="Height">

    <Border Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.BorderGlass}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border Width="88" Height="88" CornerRadius="20"
        Background="{DynamicResource App.AccentSubtle}"
        HorizontalAlignment="Center">
                    <Image Source="/Assets/Application.png"
           Width="60" Height="60"
           Stretch="Uniform"
           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="{loc:Loc Key=k77406d4cbd55}" FontSize="{DynamicResource App.Font.Title}" FontWeight="Bold"
                           Foreground="{DynamicResource App.Text}"
                           HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <TextBlock x:Name="VersionText" Text="{loc:Loc Key=k108ac1ea9492}" FontSize="{DynamicResource App.Font.Small}"
                           Foreground="{DynamicResource App.TextMuted}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Border Background="{DynamicResource App.SurfaceGlass}" CornerRadius="8"
                        BorderBrush="{DynamicResource App.BorderGlass}" BorderThickness="1"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=k9aa2ae2b2cfc}"
                                   FontSize="{DynamicResource App.Font.Body}" Foreground="{DynamicResource App.Text}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock FontSize="{DynamicResource App.Font.Small}" Foreground="{DynamicResource App.TextMuted}"
                                   TextWrapping="Wrap" LineHeight="18" Text="{loc:Loc Key=k95fc861e5cdc}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource App.SurfaceGlass}" CornerRadius="8"
                        BorderBrush="{DynamicResource App.BorderGlass}" BorderThickness="1"
                        Padding="14" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=k82f4e719a19c}" FontSize="{DynamicResource App.Font.Small}"
                                   Foreground="{DynamicResource App.TextMuted}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Loc Key=kacf67734d4b5}" FontSize="{DynamicResource App.Font.Small}"
                                   Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=kc6f1a54d31ab}" FontSize="{DynamicResource App.Font.Small}"
                                   Foreground="{DynamicResource App.TextMuted}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Loc Key=ka86d20e91831}" FontSize="{DynamicResource App.Font.Small}"
                                   Foreground="{DynamicResource App.Text}" Margin="0,0,0,6"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Key=kc011d6097bfb}" FontSize="{DynamicResource App.Font.Small}"
                                   Foreground="{DynamicResource App.TextMuted}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Loc Key=k0534b2f200ff}" FontSize="{DynamicResource App.Font.Small}"
                                   Foreground="{DynamicResource App.Text}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock Text="{loc:Loc Key=ke9f5234b4cb2}"
                           FontSize="{DynamicResource App.Font.Small}" Foreground="{DynamicResource App.TextMuted}"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <Button Content="{loc:Loc Key=k7d9eb7acb13e}" HorizontalAlignment="Center"
                        MinWidth="100" IsCancel="True" IsDefault="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</views:GlassWindow>