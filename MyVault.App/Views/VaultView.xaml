<UserControl x:Class="MyVault.App.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MyVault.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VaultViewModel}">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding LockCommand}"/>
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource App.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== SIDEBAR ========== -->
        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Background="{DynamicResource App.SurfaceGlass}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Header with inline + button -->
                <Grid Grid.Row="0" Margin="12,0,8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="VAULT CATEGORIES"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextDisabled}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Command="{Binding AddCategoryCommand}"
                            Width="22" Height="22"
                            Padding="0"
                            Cursor="Hand"
                            Background="{DynamicResource App.AccentSubtle}"
                            BorderBrush="{DynamicResource App.Accent}"
                            BorderThickness="1"
                            Foreground="{DynamicResource App.Accent}"
                            ToolTip="New category"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5">
                                    <TextBlock Text="+"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-1,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SurfaceHover}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SurfaceAlt}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Row 2: All / Favorites + divider -->
                <StackPanel Grid.Row="2">
                    <RadioButton GroupName="Filter" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding IsAllFilter, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="All">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Filter" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding IsFavoritesFilter, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Favorites">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="★" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource App.Warning}"/>
                            <TextBlock Text="Favorites" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <Border Height="1"
                            Background="{DynamicResource App.Border}"
                            Margin="8,8,8,8"/>
                </StackPanel>

                <!-- Row 4: Categories list -->
                <ScrollViewer Grid.Row="4"
                              MaxHeight="220"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Weak" Command="{Binding SetFilterCommand}" CommandParameter="Weak" Padding="6,4" Margin="2"/>
                        <Button Content="Reused" Command="{Binding SetFilterCommand}" CommandParameter="Reused" Padding="6,4" Margin="2"/>
                        <Button Content="Recent" Command="{Binding SetFilterCommand}" CommandParameter="Recent" Padding="6,4" Margin="2"/>
                        <Button Content="Trash" Command="{Binding SetFilterCommand}" CommandParameter="Trash" Padding="6,4" Margin="2"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                                <Grid>
                                    <RadioButton GroupName="Filter" Style="{StaticResource NavButton}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}">
                                        <Grid Margin="0,0,52,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="&#xE8B7;"
                                                       FontFamily="{StaticResource App.IconFont}"
                                                       FontSize="14"
                                                       Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </RadioButton>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0">
                                        <Button Style="{StaticResource GhostButton}"
                                                Width="22" Height="22" Padding="5"
                                                ToolTip="Rename category"
                                                Click="RenameCategoryInline_Click">
                                            <TextBlock Text="&#xE70F;"
                                                       FontFamily="{StaticResource App.IconFont}"
                                                       FontSize="11"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}"
                                                Width="22" Height="22" Padding="5" Margin="2,0,0,0"
                                                ToolTip="Delete category"
                                                Foreground="{DynamicResource App.Error}"
                                                Click="DeleteCategoryInline_Click">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="{StaticResource App.IconFont}"
                                                       FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Row 6: Bottom actions -->
                <StackPanel Grid.Row="6">
                    <Separator Margin="0,0,0,10" Background="{DynamicResource App.BorderSubtle}"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8" Height="36">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="+" FontSize="15" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="New" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding HealthCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE95E;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Health" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ImportExportCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Import / Export" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding SettingsCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding HelpCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Help" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding AboutCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="About" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding LockCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Lock" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== MAIN CONTENT ========== -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search bar -->
            <Border x:Name="SearchBarBorder"
                    Grid.Row="0" Margin="0,0,0,10"
                    Background="{DynamicResource App.SurfaceGlass}"
                    BorderBrush="{DynamicResource App.BorderGlass}"
                    BorderThickness="1" CornerRadius="12" Padding="6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" ToolTip="Sort entries" AutomationProperties.Name="Sort entries"/>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             Padding="10,7" FontSize="13"/>
                    <TextBlock Text="Search entries…  Ctrl+K"
                               Foreground="{DynamicResource App.TextDisabled}"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Entry list -->
            <Border x:Name="EntryListBorder"
                    Grid.Row="1" Margin="0,0,0,10"
                    Background="{DynamicResource App.SurfaceGlass}"
                    BorderBrush="{DynamicResource App.BorderGlass}"
                    BorderThickness="1" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <ListBox x:Name="EntryList"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ItemsSource="{Binding EntriesView}"
                             SelectedItem="{Binding SelectedEntry}"
                             BorderThickness="0" Background="Transparent"
                             Margin="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="EntryList_MouseDoubleClick"
                             KeyDown="EntryList_KeyDown">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,3"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VaultEntryViewModel}">
                                <Border Padding="14,11"
                                        Background="{DynamicResource App.Surface}"
                                        BorderBrush="{DynamicResource App.Border}"
                                        BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="★"
                                                   Foreground="{DynamicResource App.Warning}"
                                                   FontSize="16" Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="8"
                                                    Background="{DynamicResource App.AccentSubtle}"
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="&#xE8D7;"
                                                           FontFamily="{StaticResource App.IconFont}"
                                                           FontSize="15" Foreground="{DynamicResource App.Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource App.Text}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource App.TextMuted}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource NullOrEmptyToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Contextual row actions; no separate details panel. -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}"
                                                    Padding="0" Width="32" Height="32"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="Copy username"
                                                    ToolTip="Copy username"
                                                    Command="{Binding DataContext.CopyUsernameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource App.IconFont}" FontSize="14"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}"
                                                    Padding="0" Width="32" Height="32" Margin="4,0,0,0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="Copy password"
                                                    ToolTip="Copy password"
                                                    Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE192;" FontFamily="{StaticResource App.IconFont}" FontSize="14"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}"
                                                    Padding="0" Width="32" Height="32" Margin="4,0,0,0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="Edit entry"
                                                    ToolTip="Edit entry"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource App.IconFont}" FontSize="14"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}"
                                                    Padding="0" Width="32" Height="32" Margin="4,0,0,0"
                                                    Visibility="{Binding HasTotp, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Copy two-step verification code (changes every 30 seconds)"
                                                    AutomationProperties.Name="Copy two-step verification code"
                                                    Command="{Binding DataContext.CopyTotpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE823;" FontFamily="{StaticResource App.IconFont}" FontSize="14"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}"
                                                    Padding="0" Width="32" Height="32" Margin="4,0,0,0"
                                                    Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Restore from Trash"
                                                    AutomationProperties.Name="Restore from Trash"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource App.IconFont}" FontSize="14"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}"
                                                    Padding="0" Width="32" Height="32" Margin="4,0,0,0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ToolTip="Delete entry"
                                                    Foreground="{DynamicResource App.Error}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource App.IconFont}" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="32" MaxWidth="380"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource App.IconFont}"
                                       FontSize="44" Foreground="{DynamicResource App.TextDisabled}"
                                       HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding EmptyStateText}" FontSize="13"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Status bar with countdown -->
            <Border x:Name="StatusBarBorder"
                    Grid.Row="2"
                    Background="{DynamicResource App.SurfaceGlass}"
                    BorderBrush="{DynamicResource App.BorderGlass}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="14,9" MinHeight="44">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowCountdown}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border HorizontalAlignment="Left"
                            Height="28" MinWidth="200"
                            CornerRadius="14"
                            Background="{DynamicResource App.AccentSubtle}"
                            BorderBrush="{DynamicResource App.Accent}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#000000"/>
                        </Border.Effect>

                        <Grid>
                            <Border Background="{DynamicResource App.Accent}"
                                    Opacity="0.55"
                                    CornerRadius="13,0,0,13"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding CountdownProgress}"/>
                                </Border.RenderTransform>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="{StaticResource App.IconFont}"
                                           FontSize="12" Margin="0,0,6,0"
                                           Foreground="{DynamicResource App.Text}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CountdownMessage}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CountdownLabel}"
                                           FontSize="12" Margin="2,0,0,0"
                                           Foreground="{DynamicResource App.TextMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>