<UserControl x:Class="MyVault.App.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:MyVault.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MyVault.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VaultViewModel}">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding LockCommand}"/>
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource App.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== SIDEBAR ========== -->
        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Background="{DynamicResource App.SurfaceGlass}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,20">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                <TextBlock  Text="{loc:Loc Key=k77406d4cbd55}" FontSize="{DynamicResource App.Font.Title}" Foreground="{DynamicResource App.Text}" Margin="12,0,8,16"/>
                <StackPanel >
                    <TextBlock Text="{loc:Loc Key=kdc20b3d5d2cd}" Foreground="{DynamicResource App.TextMuted}" Margin="12,0,0,6"/>
                    <RadioButton GroupName="Filter" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding IsAllFilter, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="All">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=ka52ace420f21}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Filter" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding IsFavoritesFilter, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Favorites">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="★" FontSize="{DynamicResource App.Font.Body}" Margin="0,0,10,0" Foreground="{DynamicResource App.Warning}"/>
                            <TextBlock Text="{loc:Loc Key=k7a1f2a83aca9}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <Border Height="1"
                            Background="{DynamicResource App.Border}"
                            Margin="8,8,8,8"/>
                </StackPanel>                <Grid  Margin="12,8,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{loc:Loc Key=kb8b1d894c683}"
                               FontSize="{DynamicResource App.Font.Small}" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextDisabled}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Command="{Binding AddCategoryCommand}"
                            Width="22" Height="22"
                            Padding="0"
                            Cursor="Hand"
                            Background="{DynamicResource App.AccentSubtle}"
                            BorderBrush="{DynamicResource App.Accent}"
                            BorderThickness="1"
                            Foreground="{DynamicResource App.Accent}"
                            ToolTip="{loc:Loc Key=k1ab1e121c0df}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5">
                                    <TextBlock Text="+"
                                               FontSize="{DynamicResource App.Font.Body}"
                                               FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-1,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SurfaceHover}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SurfaceAlt}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                                <Grid>
                                    <RadioButton GroupName="Filter" Style="{StaticResource NavButton}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}">
                                        <Grid Margin="0,0,52,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="&#xE8B7;"
                                                       FontFamily="{StaticResource App.IconFont}"
                                                       FontSize="14"
                                                       Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </RadioButton>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0">
                                        <Button Style="{StaticResource GhostButton}"
                                                Width="22" Height="22" Padding="5"
                                                ToolTip="{loc:Loc Key=k897993135e2c}"
                                                Click="RenameCategoryInline_Click">
                                            <TextBlock Text="&#xE70F;"
                                                       FontFamily="{StaticResource App.IconFont}"
                                                       FontSize="11"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}"
                                                Width="22" Height="22" Padding="5" Margin="2,0,0,0"
                                                ToolTip="{loc:Loc Key=ka91d00879a3d}"
                                                Foreground="{DynamicResource App.Error}"
                                                Click="DeleteCategoryInline_Click">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="{StaticResource App.IconFont}"
                                                       FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>                    <TextBlock Text="{loc:Loc Key=kfdd8549491a9}" Foreground="{DynamicResource App.TextMuted}" Margin="12,16,0,6"/>
                    <RadioButton GroupName="Filter" Style="{StaticResource NavButton}" IsChecked="{Binding IsWeakFilter,Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="Weak">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" MaxWidth="120" Text="{loc:Loc Key=k7c94df3b2522}" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton GroupName="Filter" Style="{StaticResource NavButton}" IsChecked="{Binding IsReusedFilter,Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="Reused">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8D4;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" MaxWidth="120" Text="{loc:Loc Key=kf3f35d906a66}" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton GroupName="Filter" Style="{StaticResource NavButton}" IsChecked="{Binding IsRecentFilter,Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="Recent">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE81C;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" MaxWidth="120" Text="{loc:Loc Key=k5c79d33c3443}" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton GroupName="Filter" Style="{StaticResource NavButton}" IsChecked="{Binding IsTrashFilter,Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="Trash">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE74D;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" MaxWidth="120" Text="{loc:Loc Key=kc560122ac470}" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>

                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1">
                    <Separator Margin="0,0,0,10" Background="{DynamicResource App.BorderSubtle}"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8" Height="36">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="+" FontSize="{DynamicResource App.Font.Title}" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=k18fdd549b2ed}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding HealthCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE95E;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=k55898449eb74}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ImportExportCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=k6e061fabef21}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding SettingsCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=k74a883a037bc}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding HelpCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=kb79cac926e0b}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding AboutCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=k4efca0d10c5f}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding LockCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource App.IconFont}" FontSize="14" Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=kdb44b8db4f05}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== MAIN CONTENT ========== -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search bar -->
            <Border x:Name="SearchBarBorder"
                    Grid.Row="0" Margin="0,0,0,10"
                    Background="{DynamicResource App.SurfaceGlass}"
                    BorderBrush="{DynamicResource App.BorderGlass}"
                    BorderThickness="1" CornerRadius="12" Padding="6">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="1" Style="{StaticResource MinimalSortCombo}" MinWidth="96" MaxWidth="150" VerticalAlignment="Center" Margin="8,0,0,0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" ToolTip="{loc:Loc Key=k5474e1893910}" AutomationProperties.Name="{loc:Loc Key=k5474e1893910}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource ChoiceLabel}"><Binding/><Binding Source="{x:Static loc:LocalizationService.Instance}" Path="Language"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             Padding="10,7" FontSize="{DynamicResource App.Font.Body}"/>
                    <TextBlock Text="{loc:Loc Key=k092ec953e2df}"
                               Foreground="{DynamicResource App.TextDisabled}"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                </StackPanel>
            </Border>

            <!-- Entry list -->
            <Border x:Name="EntryListBorder"
                    Grid.Row="1" Margin="0,0,0,10"
                    Background="{DynamicResource App.SurfaceGlass}"
                    BorderBrush="{DynamicResource App.BorderGlass}"
                    BorderThickness="1" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <ListBox x:Name="EntryList"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ItemsSource="{Binding EntriesView}"
                             SelectedItem="{Binding SelectedEntry}"
                             BorderThickness="0" Background="Transparent"
                             Margin="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="EntryList_MouseDoubleClick"
                             KeyDown="EntryList_KeyDown">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,3"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VaultEntryViewModel}">
                                <Border Padding="{DynamicResource App.RowPadding}"
                                        Background="{DynamicResource App.Surface}"
                                        BorderBrush="{DynamicResource App.Border}"
                                        BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="★"
                                                   Foreground="{DynamicResource App.Warning}"
                                                   FontSize="{DynamicResource App.Font.Title}" Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="8"
                                                    Background="{DynamicResource App.AccentSubtle}"
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="&#xE8D7;"
                                                           FontFamily="{StaticResource App.IconFont}"
                                                           FontSize="15" Foreground="{DynamicResource App.Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="{DynamicResource App.Font.Body}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource App.Text}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="{DynamicResource App.Font.Small}"
                                                           Foreground="{DynamicResource App.TextMuted}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource NullOrEmptyToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Contextual row actions; no separate details panel. -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowIconButton}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="{loc:Loc Key=k7ba3cdab9a58}"
                                                    ToolTip="{loc:Loc Key=k7ba3cdab9a58}"
                                                    Command="{Binding DataContext.CopyUsernameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE77B;" Style="{StaticResource RowIconGlyph}"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconButton}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="{loc:Loc Key=ke8cd8b5d57c9}"
                                                    ToolTip="{loc:Loc Key=ke8cd8b5d57c9}"
                                                    Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE192;" Style="{StaticResource RowIconGlyph}"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconButton}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="{loc:Loc Key=k93231772b203}"
                                                    ToolTip="{loc:Loc Key=k93231772b203}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE70F;" Style="{StaticResource RowIconGlyph}"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconButton}"
                                                    Visibility="{Binding HasTotp, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{loc:Loc Key=k110a6a01eba6}"
                                                    AutomationProperties.Name="{loc:Loc Key=kbc443c51ad40}"
                                                    Command="{Binding DataContext.CopyTotpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE823;" Style="{StaticResource RowIconGlyph}"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconButton}"
                                                    Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{loc:Loc Key=kee661347c0df}"
                                                    AutomationProperties.Name="{loc:Loc Key=kee661347c0df}"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE7A7;" Style="{StaticResource RowIconGlyph}"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconButton}"
                                                    ToolTip="{loc:Loc Key=kd2968b26e985}"
                                                    Foreground="{DynamicResource App.Error}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource RowIconGlyph}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="32" MaxWidth="380"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource App.IconFont}"
                                       FontSize="44" Foreground="{DynamicResource App.TextDisabled}"
                                       HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding EmptyStateText}" FontSize="{DynamicResource App.Font.Body}"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Status bar with countdown -->
            <Border x:Name="StatusBarBorder"
                    Grid.Row="2"
                    Background="{DynamicResource App.SurfaceGlass}"
                    BorderBrush="{DynamicResource App.BorderGlass}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="14,9" MinHeight="44">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{DynamicResource App.Font.Small}" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowCountdown}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border HorizontalAlignment="Left"
                            Height="28" MinWidth="200"
                            CornerRadius="14"
                            Background="{DynamicResource App.AccentSubtle}"
                            BorderBrush="{DynamicResource App.Accent}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#000000"/>
                        </Border.Effect>

                        <Grid>
                            <Border Background="{DynamicResource App.Accent}"
                                    Opacity="0.55"
                                    CornerRadius="13,0,0,13"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding CountdownProgress}"/>
                                </Border.RenderTransform>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="{StaticResource App.IconFont}"
                                           FontSize="12" Margin="0,0,6,0"
                                           Foreground="{DynamicResource App.Text}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CountdownMessage}"
                                           FontSize="{DynamicResource App.Font.Small}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CountdownLabel}"
                                           FontSize="{DynamicResource App.Font.Small}" Margin="2,0,0,0"
                                           Foreground="{DynamicResource App.TextMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>