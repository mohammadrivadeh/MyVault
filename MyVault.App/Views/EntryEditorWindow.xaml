<views:GlassWindow x:Class="MyVault.App.Views.EntryEditorWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:vm="clr-namespace:MyVault.App.ViewModels"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   d:DataContext="{d:DesignInstance Type=vm:EntryEditorViewModel}"
                   Title="{Binding WindowTitle}"
                   Width="560" Height="640">

    <Border Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.BorderGlass}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding WindowTitle}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.Text}"
                       Margin="0,0,0,16"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Title | Username -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Title *" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TitleBox"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Username" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Row 1: Password (full width) -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                        <TextBlock Text="Password" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextMuted}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <PasswordBox x:Name="PwdBox" Padding="10,8,38,8"
                                             PasswordChanged="PwdBox_PasswordChanged"/>
                                <TextBox x:Name="RevealBox" Visibility="Collapsed"
                                         Padding="10,8,38,8"
                                         TextChanged="RevealBox_TextChanged"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Width="28" Height="28" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="4,4,4,4"
                                        Click="ToggleReveal_Click"
                                        ToolTip="Show / hide password">
                                    <TextBlock Text="  👁" FontSize="14"/>
                                </Button>
                            </Grid>
                            <Button Grid.Column="1" Content="Generate"
                                    Margin="6,0,0,0"
                                    Command="{Binding GenerateCommand}"/>
                        </Grid>
                        <Expander Header="Generator options" Foreground="{DynamicResource App.Text}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Length (4–256)"/><TextBox Text="{Binding GeneratorLength}"/>
                                <WrapPanel>
                                    <CheckBox Content="A–Z" IsChecked="{Binding GenerateUpper}" Margin="4"/>
                                    <CheckBox Content="a–z" IsChecked="{Binding GenerateLower}" Margin="4"/>
                                    <CheckBox Content="0–9" IsChecked="{Binding GenerateDigits}" Margin="4"/>
                                    <CheckBox Content="Symbols" IsChecked="{Binding GenerateSymbols}" Margin="4"/>
                                    <CheckBox Content="Avoid ambiguous" IsChecked="{Binding AvoidAmbiguous}" Margin="4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="{Binding PasswordStrengthLabel}"
                                   FontSize="11" Foreground="{DynamicResource App.TextMuted}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Row 2: URL | Category -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                        <TextBlock Text="URL" FontSize="11" FontWeight="SemiBold"
               Foreground="{DynamicResource App.TextMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
             Height="50"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                        <TextBlock Text="Category" FontSize="11" FontWeight="SemiBold"
               Foreground="{DynamicResource App.TextMuted}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CategoryOptions}"
              SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay}"
              SelectedValuePath="Id"
              DisplayMemberPath="Name"
              Height="50"
              VerticalContentAlignment="Center"
              Padding="10,0"/>
                    </StackPanel>

                    <!-- Row 3: Tags (full width) -->
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0">
                        <TextBlock Text="Tags (comma‑separated)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Row 4: Notes (full width) -->
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,12,0,0">
                        <TextBlock Text="Notes" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="80" VerticalScrollBarVisibility="Auto"/>
                        <Expander Margin="0,16,0,0" Foreground="{DynamicResource App.Text}">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Two-step verification" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotpSetupStatus}" FontSize="11" Foreground="{DynamicResource App.TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander.Header>
                            <Border Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Use MyVault like an authenticator" FontWeight="SemiBold"/>
                                    <TextBlock Text="Generate a 6-digit login code that changes every 30 seconds. No SMS or internet connection is needed." TextWrapping="Wrap" Foreground="{DynamicResource App.TextMuted}" Margin="0,4,0,12"/>
                                    <TextBlock Text="1. Start on the website" FontWeight="SemiBold"/>
                                    <TextBlock Text="Open the account's Security settings → Two-step verification / 2FA. Choose Authenticator app, not SMS." TextWrapping="Wrap" Foreground="{DynamicResource App.TextMuted}" Margin="0,4,0,12"/>
                                    <TextBlock Text="2. Get the manual setup key" FontWeight="SemiBold"/>
                                    <TextBlock Text="Beside the QR code, choose Can't scan? / Enter key manually and copy the longer setup key. MyVault does not scan QR images yet." TextWrapping="Wrap" Foreground="{DynamicResource App.TextMuted}" Margin="0,4,0,12"/>
                                    <TextBlock Text="3. Paste that key here" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="TotpBox" PasswordChanged="TotpBox_PasswordChanged" AutomationProperties.Name="Authenticator manual setup key" ToolTip="Paste the Base32 setup key, not a 6-digit code"/>
                                    <TextBlock Text="{Binding TotpSetupHint}" TextWrapping="Wrap" Foreground="{DynamicResource App.TextMuted}" Margin="0,6,0,12"/>
                                    <TextBlock Text="4. Save, copy a code, and confirm" FontWeight="SemiBold"/>
                                    <TextBlock Text="Save this entry in MyVault. Click its clock icon to copy a code, paste it into the website's verification field, then confirm on the website. Saving a key here alone does not turn on 2FA." TextWrapping="Wrap" Foreground="{DynamicResource App.TextMuted}" Margin="0,4,0,12"/>
                                    <TextBlock Text="5. Keep a recovery method" FontWeight="SemiBold"/>
                                    <TextBlock Text="Store the website's recovery codes somewhere safe outside this vault. Password and authenticator key stored together share the same vault protection." TextWrapping="Wrap" Foreground="{DynamicResource App.TextMuted}" Margin="0,4,0,12"/>
                                    <TextBlock Text="Later logins: use your password, then the clock icon for a fresh code. If a code is rejected, wait for the next one and check Windows time. Supported: SHA-1 · 6 digits · 30 seconds." TextWrapping="Wrap" Foreground="{DynamicResource App.TextMuted}"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <CheckBox Content="Mark as favorite" IsChecked="{Binding IsFavorite}"
                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource App.Error}"
                               VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="220"/>
                    <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="Save" Click="Save_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</views:GlassWindow>