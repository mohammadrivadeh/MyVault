<views:GlassWindow x:Class="MyVault.App.Views.CategoryNameDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:loc="clr-namespace:MyVault.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   Width="400"
                   SizeToContent="Height"
                   WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.BorderGlass}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText"
                       FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.Text}"/>

            <TextBlock Grid.Row="1" Text="{loc:Loc Key=k73ddd937c98b}"
                       FontSize="{DynamicResource App.Font.Small}" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.TextMuted}"
                       Margin="0,14,0,4"/>

            <TextBox Grid.Row="2" x:Name="NameBox" MaxLength="50"/>

            <TextBlock Grid.Row="3" x:Name="ErrorText"
                       FontSize="{DynamicResource App.Font.Small}"
                       Foreground="{DynamicResource App.Error}"
                       Margin="0,6,0,0"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{loc:Loc Key=k19766ed6ccb2}" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc Key=k565339bc4d33}" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</views:GlassWindow>