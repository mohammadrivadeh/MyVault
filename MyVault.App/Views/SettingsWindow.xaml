<views:GlassWindow x:Class="MyVault.App.Views.SettingsWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:vm="clr-namespace:MyVault.App.ViewModels"
                   xmlns:views="clr-namespace:MyVault.App.Views"
                   mc:Ignorable="d"
                   d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
                   Title="Settings"
                   Width="440"
                   SizeToContent="Height">

    <Border Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.BorderGlass}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Settings"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}"
                           Margin="0,0,0,14"/>

                <TextBlock Text="Auto-lock after"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding AutoLockOptions}"
                          SelectedValue="{Binding AutoLockMinutes, Mode=TwoWay}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Label"/>

                <TextBlock Text="Clear clipboard after"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,10,0,4"/>
                <ComboBox ItemsSource="{Binding ClearClipboardOptions}"
                          SelectedValue="{Binding ClearClipboardSeconds, Mode=TwoWay}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Label"/>

                <TextBlock Text="Color theme (live preview)" Foreground="{DynamicResource App.TextMuted}" Margin="0,12,0,4"/>
                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}"/>
                <TextBlock Text="Motion (always respects Windows reduced motion)" Foreground="{DynamicResource App.TextMuted}" Margin="0,12,0,4" TextWrapping="Wrap"/>
                <ComboBox ItemsSource="{Binding MotionOptions}" SelectedItem="{Binding Motion, Mode=TwoWay}"/>
                <TextBlock Text="Master password"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextMuted}"
                           Margin="0,12,0,6"/>
                <Button Content="Change master password…"
                        Command="{Binding ChangePasswordCommand}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButton}"/>

                <Border Background="{DynamicResource App.WarningBg}"
                        CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource App.Warning}">
                        The vault also locks automatically when you sign out or lock
                        Windows (Win+L), regardless of this setting.
                    </TextBlock>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Save" IsDefault="True" Click="Save_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</views:GlassWindow>